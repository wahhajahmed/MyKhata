{
  "name": "mykhata",
  "version": "0.2.0",
  "private": true,
  "description": "Professional Offline-First Personal Finance and Digital Khata Management Application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:build-main": "tsc -p tsconfig.electron.json",
    "desktop:dev": "npm run electron:build-main && electron .",
    "desktop:build": "npm run rebuild:electron && npm run build && npm run electron:build-main && electron-builder --win --x64 -p never",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "android:build": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "8.0.0",
    "@capacitor-community/sqlite": "6.0.1",
    "@capacitor/app": "6.0.1",
    "@capacitor/core": "6.2.1",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/preferences": "6.0.3",
    "@capacitor/share": "6.0.3",
    "@hookform/resolvers": "3.9.1",
    "@supabase/supabase-js": "2.47.10",
    "better-sqlite3-multiple-ciphers": "11.8.1",
    "big.js": "6.2.2",
    "capacitor-secure-storage-plugin": "0.10.0",
    "lucide-react": "0.468.0",
    "pdfmake": "0.2.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "react-router-dom": "6.28.1",
    "recharts": "2.15.0",
    "sql.js": "1.12.0",
    "zod": "3.24.1",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/cli": "6.2.1",
    "@electron/rebuild": "3.7.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/better-sqlite3": "7.6.12",
    "@types/big.js": "6.2.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "better-sqlite3": "11.8.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.9"
  },
  "build": {
    "appId": "com.mykhata.app",
    "productName": "MyKhata",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3-multiple-ciphers/**/*",
      "node_modules/sql.js/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
